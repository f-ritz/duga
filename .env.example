# DeepSeek (required)
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# Telegram (required)
TELEGRAM_BOT_TOKEN=123456789:AAFxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=987654321

# Optional: better search providers (recommended for quality)
# BRAVE_API_KEY=
# TAVILY_API_KEY=

# Apify for Instagram profile scraping (recommended for IG)
# APIFY_API_KEY=apify_api_...

# Optional vision override. Leave unset to try DeepSeek first.
# VISION_API_KEY=
# VISION_BASE_URL=https://api.deepseek.com
# VISION_MODEL=deepseek-v4-flash

# Misc
USER_TIMEZONE=UTC
MAX_SEARCH_RESULTS=15
MAX_WEBSITES=20
MAX_IMAGES_TO_ANALYZE=5

# Chunked LLM delivery (new in 1.1+)
# When you have many keywords/websites/handles, the program splits the targets
# into groups of this many entries, gathers+briefs each chunk separately, then
# synthesizes a final briefing. Keeps prompts well inside high-quality range.
# Set to 0 to disable (one large call, only suitable for small target lists).
DUGA_CHUNK_SIZE=10

# Note: Instagram handles are now handled with standard web URL/profile scan + search
# (like other social). No Apify or post-count limit for IG.
